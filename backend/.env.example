# Sparsh AI Backend Environment Configuration

# Server Config
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,https://sparsh.app

# Supabase (Database & Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional LLM Providers for NCERT RAG & Multi-Modal Q&A
OPENAI_API_KEY=your-openai-api-key
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
OLLAMA_API_KEY=your-ollama-api-key
OLLAMA_MODEL=gpt-oss:120b
GEMMA_API_KEY=your-gemma-api-key
GEMMA_MODEL=google/gemma-2-27b-it

# AI Model Paths (Defaults to bundled models in ./models)
# SIGN_MODEL_PATH=/app/models/best_sign_model.pth
# LANDMARK_MODEL_PATH=/app/models/hand_landmarker.task

# Smart Glasses Camera Integration (ESP32-S3 + OV3660)
GLASSES_URL=http://192.168.1.150:80
GLASSES_DEVICE_TOKEN=your-glasses-device-token
VISION_MODEL=meta/llama-3.2-11b-vision-instruct

