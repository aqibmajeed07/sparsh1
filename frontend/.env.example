# Sparsh Frontend Environment Configuration

# Supabase (Auth, PostgreSQL DB & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Backend API URL (FastAPI with bundled Niral AI Model)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Live Classroom & Video SDKs
NEXT_PUBLIC_AGORA_APP_ID=your-agora-app-id
NEXT_PUBLIC_DAILY_API_KEY=your-daily-api-key
DAILY_API_KEY=your-daily-api-key

# Optional Multi-Modal & AI Keys
NEXT_PUBLIC_NVIDIA_API_KEY=your-nvidia-api-key
RESEND_API_KEY=your-resend-api-key
